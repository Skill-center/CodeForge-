{
  "description": "IME composition suite for the editor benchmark (Phase 2 W3), played through the DevTools protocol by tool/bench_cdp.mjs. compose = Input.imeSetComposition (caret at the end of the composing text); commit and insert = Input.insertText (commits an active composition); key = Input.dispatchKeyEvent. A case passes when the document equals `expected` afterwards.",
  "cases": [
    {
      "id": "latin-predictive",
      "steps": [["compose", "h"], ["compose", "he"], ["compose", "hel"], ["compose", "hello"], ["commit", "hello"], ["insert", " "], ["compose", "w"], ["compose", "wo"], ["compose", "world"], ["commit", "world"]],
      "expected": "hello world"
    },
    {
      "id": "autocorrect-replace",
      "steps": [["compose", "t"], ["compose", "te"], ["compose", "teh"], ["commit", "the"]],
      "expected": "the"
    },
    {
      "id": "pinyin",
      "steps": [["compose", "n"], ["compose", "ni"], ["compose", "nih"], ["compose", "niha"], ["compose", "nihao"], ["commit", "你好"]],
      "expected": "你好"
    },
    {
      "id": "japanese",
      "steps": [["compose", "k"], ["compose", "か"], ["compose", "かn"], ["compose", "かん"], ["compose", "かんj"], ["compose", "かんじ"], ["commit", "漢字"]],
      "expected": "漢字"
    },
    {
      "id": "hangul",
      "steps": [["compose", "ㅎ"], ["compose", "하"], ["compose", "한"], ["commit", "한"], ["compose", "ㄱ"], ["compose", "그"], ["compose", "글"], ["commit", "글"]],
      "expected": "한글"
    },
    {
      "id": "emoji",
      "steps": [["insert", "😀"], ["insert", "👍🏽"], ["insert", "👩‍💻"]],
      "expected": "😀👍🏽👩‍💻"
    },
    {
      "id": "cancel-composition",
      "steps": [["insert", "a"], ["compose", "x"], ["compose", "xyz"], ["compose", ""], ["insert", "b"]],
      "expected": "ab"
    },
    {
      "id": "mid-line",
      "initial": "call();",
      "cursor": 5,
      "steps": [["compose", "v"], ["compose", "va"], ["compose", "val"], ["commit", "value"]],
      "expected": "call(value);"
    },
    {
      "id": "backspace-in-composition",
      "steps": [["compose", "c"], ["compose", "co"], ["compose", "cod"], ["key", "Backspace"], ["compose", "co"], ["compose", "cop"], ["commit", "copy"]],
      "expected": "copy"
    }
  ]
}
