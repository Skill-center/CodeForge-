<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions arrive with their phases, each reviewed against
         docs/SECURITY.md and the store texts (docs/store/), and CI's Release
         manifest gate (tool/ci/check_manifest.py) allows nothing else.
         INTERNET (Phase 5 W1, the owner's decision of 2026-11-18): the
         userland's tools reach the network when the user runs them (npm, pip,
         git, curl). The app's own code connects nowhere.
         Backup (Phase 3 W1, ADR-0012): Android's backup is the user's choice,
         off by default. CodeForgeBackupAgent writes the projects, the database
         and the settings only while the switch in Settings > Privacy is on;
         fullBackupOnly keeps file-based Auto Backup, and the rules files list
         what it may take (logs never: they live in no_backup/). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The terminal sessions' foreground service (Phase 5 W5): it keeps the
         app's process, and with it the sessions the user started, running
         while the user is elsewhere. Its type is specialUse: a terminal runs
         for as long as the user lets it, and dataSync's six hours in a day
         would end it. POST_NOTIFICATIONS is asked at the first session on
         Android 13 and later; declined, sessions still run. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="CodeForge"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:backupAgent=".CodeForgeBackupAgent"
        android:fullBackupOnly="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Platform views (Phase 5 W6, the owner's decision of 2026-11-21):
             Hybrid Composition++ wherever the engine can (Android 14 and
             later, Impeller on Vulkan). The WebViews of the editor and the
             terminal then sit in Android's view hierarchy, composed with
             SurfaceControl, instead of each being drawn into a texture that
             Flutter composes (TLHC, which held 31-43 MB of buffers for the
             terminal on the Pixel 8a). Elsewhere Flutter keeps TLHC.
             docs/TERMINAL_ARCHITECTURE.md §2.2. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableHcpp"
            android:value="true" />
        <service
            android:name=".terminal.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Terminal sessions that the user starts in the Linux environment of the app, which run until the user ends them" />
        </service>
        <!-- Renderer: Flutter's default, Impeller, since Phase 3 W6. Phases 1
             and 2 opted out (EnableImpeller=false) because Impeller's
             OpenGLES backend did not size its surface on the software-GL CI
             emulator; Flutter 3.47 deprecated that opt-out, and W6's gate run
             decides (docs/phases/PHASE_3_PLAN.md, W6). -->
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
