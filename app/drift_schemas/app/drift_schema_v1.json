  "fixed_sql": [
    {
      "name": "workspaces",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workspaces\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"last_opened_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "open_tabs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"open_tabs\" (\"workspace_id\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"active\" IN (0, 1)), \"selection_anchor\" INTEGER NULL, \"selection_head\" INTEGER NULL, \"scroll_top\" REAL NOT NULL DEFAULT 0.0, PRIMARY KEY (\"workspace_id\", \"path\"));"
        }
      ]
    },
    {
      "name": "journal_documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"journal_documents\" (\"workspace_id\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"snapshot_text\" TEXT NOT NULL, \"snapshot_version\" INTEGER NOT NULL, \"base_digest\" TEXT NULL, \"line_ending\" TEXT NOT NULL, \"bom\" INTEGER NOT NULL CHECK (\"bom\" IN (0, 1)), \"language\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"workspace_id\", \"path\"));"
        }
      ]
    },
    {
      "name": "journal_changes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"journal_changes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"workspace_id\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"base_version\" INTEGER NOT NULL, \"version\" INTEGER NOT NULL, \"length_before\" INTEGER NOT NULL, \"length_after\" INTEGER NOT NULL, \"changes\" TEXT NOT NULL);"
        }
      ]
    },
    {
