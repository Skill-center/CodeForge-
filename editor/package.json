{
  "name": "codeforge-editor",
  "version": "0.2.0",
  "private": true,
  "description": "CodeForge's web pages: the editor (CodeMirror 6) and the terminal (xterm.js), each in the Android WebView behind its CodeForge bridge protocol.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "licenses": "node tool/check_licenses.mjs",
    "build": "node tool/build.mjs && node tool/build_terminal.mjs",
    "verify": "node tool/verify_bundle.mjs && node tool/verify_terminal.mjs",
    "build:bench": "node tool/build_bench.mjs",
    "bench:cdp": "node tool/bench_cdp.mjs",
    "ci": "npm run typecheck && npm test && npm run licenses && npm run build && npm run verify && npm run build:bench"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "monaco-editor": "0.57.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
